<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only asked for when you tap Settings > Notifications > Background activity, so the background check runs on time. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- AndroidX Biometric adds the old fingerprint permission, which is only for Android 8 and older. The app lock
         uses USE_BIOMETRIC (also added by AndroidX Biometric), so it's removed. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <!-- WorkManager adds the foreground-service permission for long jobs shown as a notification. The background check
         is a short job that never runs as a foreground service, so it's removed (with the service below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <!-- Hides other apps' floating windows over sign-in, the lock and PIN screens, screens with API keys, passwords
         and tokens, and delete and certificate confirmations only. Install-time permission, no prompt. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- intentMatchingFlags (Android 16+): other apps can only reach SeerrCtrl's exported components with an intent
         that matches their filters (the launcher, seerrctrl:// links, and ntfy's UnifiedPush broadcasts and bind). -->
    <application
        android:name=".SeerrApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:intentMatchingFlags="enforceIntentFilter"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SeerrCtrl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- seerrctrl://movie/{tmdbId} and seerrctrl://tv/{tmdbId} from other apps (ArrCtrl's "Open in SeerrCtrl").
                 Not BROWSABLE, so web pages can't open it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="seerrctrl" android:host="movie" />
                <data android:scheme="seerrctrl" android:host="tv" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.ActionReceiver"
            android:exported="false" />
        <!-- Push through ntfy (UnifiedPush). Exported because ntfy is another app; every broadcast must carry the secret
             token of SeerrCtrl's registration or it's ignored, and a push only makes the app check your Seerr server. -->
        <receiver
            android:name=".notify.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <!-- ntfy binds to this for a few seconds before a push, so SeerrCtrl can check your server at once. -->
        <service
            android:name=".notify.RaiseToForegroundService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>
        <!-- WorkManager's foreground service, for long jobs shown as a notification. SeerrCtrl never uses it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!-- AndroidX's profile installer adds an exported receiver for app-store and adb tooling. It isn't needed in
             the app, so it's removed. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
        <!-- WorkManager's diagnostics hook (only for adb dumps) isn't needed in the app. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <!-- No downloadable emoji font: androidx.emoji2 doesn't look for one at start-up, and emoji
             are drawn with the phone's own emoji font. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

    <!-- ntfy, the only push app SeerrCtrl uses, and ArrCtrl for "Open in ArrCtrl". -->
    <queries>
        <package android:name="io.heckel.ntfy" />
        <package android:name="com.vknxworks.arrctrl" />
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="arrctrl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
