<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ctrl / Signal Light (the device is in light mode). The window is the app's background colour
         before Compose draws; dark mode is in values-night. -->
    <style name="Theme.SeerrCtrl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F5F5F1</item>
        <item name="android:colorBackground">#F5F5F1</item>
        <item name="android:colorAccent">#6A3BDB</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
